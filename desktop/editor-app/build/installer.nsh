; Wording for the Video Editor installer wizard. Pages themselves come from electron-builder.
!macro customHeader
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Video Editor by Evans Large"
  !define MUI_WELCOMEPAGE_TEXT "This wizard installs Video Editor by Evans Large on your computer.$\r$\n$\r$\nCut, caption and export videos on your own computer. Click Next to continue."
  !define MUI_FINISHPAGE_TITLE "Video Editor is installed"
  !define MUI_FINISHPAGE_TEXT "Video Editor is ready. Open it from your Start menu. Nothing you edit is uploaded."
!macroend
