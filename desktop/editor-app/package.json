{
  "name": "editor-app",
  "productName": "Video Editor by Evans Large",
  "version": "1.0.1",
  "description": "Video Editor by Evans Ademilua: cut, caption and export videos. Works on your computer and nothing is uploaded.",
  "author": "Evans Ademilua",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.evansademilua.videoeditor",
    "productName": "Video Editor by Evans Large",
    "copyright": "Evans Ademilua",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "package.json",
      "update-gate.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Editor-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Video Editor by Evans Large",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Video Editor by Evans Large",
      "menuCategory": "Evans Large"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Editor-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Video Editor can record from the camera.",
        "NSMicrophoneUsageDescription": "Video Editor can record a voiceover."
      }
    },
    "dmg": {
      "title": "Video Editor"
    },
    "pkg": {
      "installLocation": "/Applications/Evans Large",
      "isRelocatable": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Evansrite1/portfolio/releases/download/editor-latest/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
