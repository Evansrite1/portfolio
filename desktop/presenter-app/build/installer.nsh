; Wording for the Presenter installer wizard. Pages themselves come from electron-builder.
!macro customHeader
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Presenter by Evans Large"
  !define MUI_WELCOMEPAGE_TEXT "This wizard installs Presenter by Evans Large on your computer.$\r$\n$\r$\nShow songs, Bible verses, photos and videos on a TV or projector. Click Next to continue."
  !define MUI_FINISHPAGE_TITLE "Presenter is installed"
  !define MUI_FINISHPAGE_TEXT "Presenter is ready. Open it from your Start menu. It opens the TV screen on your second screen by itself."
!macroend
