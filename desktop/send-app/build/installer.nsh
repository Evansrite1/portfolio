; Wording for the File Share installer wizard (welcome page, finish page). Pages themselves come from electron-builder.
!macro customHeader
  !define MUI_WELCOMEPAGE_TITLE "Welcome to File Share by Evans Large"
  !define MUI_WELCOMEPAGE_TEXT "This wizard installs File Share by Evans Large on your computer.$\r$\n$\r$\nSend files and folders to another computer over Wi-Fi. Install it on both computers.$\r$\n$\r$\nClick Next to continue."
  !define MUI_FINISHPAGE_TITLE "File Share is installed"
  !define MUI_FINISHPAGE_TEXT "File Share by Evans Large is ready.$\r$\n$\r$\nOpen it on both computers. Press Send on one and Receive on the other. The first time, press Allow File Share so the other computer can connect."
!macroend
