{
  "name": "color-picker-app",
  "productName": "Color Picker by Evans Large",
  "version": "1.0.1",
  "description": "Color Picker by Evans Large: pick the color of any pixel on your screen, in any app or window. Windows and Mac.",
  "author": "Evans Ademilua",
  "homepage": "https://evansademilua.vercel.app/tools/color-picker/",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:pkg:arm64": "electron-builder --mac pkg --arm64 --publish never",
    "dist:pkg:x64": "electron-builder --mac pkg --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.evansademilua.colorpicker",
    "productName": "Color Picker by Evans Large",
    "copyright": "Evans Ademilua",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Color-Picker-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Color Picker by Evans Large",
      "uninstallDisplayName": "Color Picker by Evans Large",
      "menuCategory": "Evans Large"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Color-Picker-mac-${arch}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Color Picker by Evans Large reads the color of the pixel you click on your screen. Nothing is saved or sent anywhere."
      }
    },
    "dmg": {
      "title": "Color Picker by Evans Large"
    },
    "pkg": {
      "installLocation": "/Applications/Evans Large",
      "isRelocatable": false
    }
  }
}
