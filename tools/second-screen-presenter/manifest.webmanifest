    { "src": "/tools/second-screen-presenter/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/tools/second-screen-presenter/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
