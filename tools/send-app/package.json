{
  "name": "send-app",
  "productName": "File Share",
  "version": "1.0.0",
  "description": "Send files to another laptop on the same Wi‑Fi. No server, no upload.",
  "author": "Evans Ademilua",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.evansademilua.filetransfer",
    "productName": "File Share",
    "copyright": "Evans Ademilua",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup.${exe ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}.dmg"
    }
  }
}